# Supabase Configuration
# Copy this file to .env and fill in your actual values

# Your Supabase Project URL (from Settings > API)
VITE_SUPABASE_URL=your-project-url-here

# Your Supabase anon/public key (from Settings > API)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: for local Ayurveda RAG ingestion (npm run ingest:ayurveda)
# Get key from https://aistudio.google.com/apikey
# GEMINI_API_KEY=your-google-ai-key-here

# Optional: for Edge Function to write to DB during ingestion (else anon key is used)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Ayurveda pay amounts are fixed server-side (₹89 basic / ₹249 full) in Edge Functions.

# --- Supabase Edge Function secrets (Dashboard → Project Settings → Edge Functions → Secrets,
#     or: npx supabase secrets set KEY=value). Not used by Vite directly.
#
# GEMINI_API_KEY=...          # Required for embeddings + default text generation
# ANTHROPIC_API_KEY=sk-ant-... # Optional: Claude for Ayurveda text (see below)
# AYURVEDA_LLM_PROVIDER=claude  # Optional: gemini (default) | claude — RAG embeddings always use Gemini
# CLAUDE_MODEL=claude-3-5-haiku-20241022  # Optional: Ayurveda text generation
# CLAUDE_VISION_MODEL=claude-3-5-sonnet-20241022  # Optional: PDF/image lab report extraction (analyze-health-report)
